# Bind locally by default. Do not expose this development server to the public internet.
FILELAB_HOST=127.0.0.1
FILELAB_PORT=8000
FILELAB_MAX_FILE_MB=40
FILELAB_MAX_REQUEST_MB=80
# Optional result directory. Defaults to the operating system temporary directory.
# FILELAB_STORAGE_DIR=/path/to/private/temp/filelab-jobs
